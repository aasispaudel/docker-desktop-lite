{
  "name": "docklite",
  "displayName": "Docklite",
  "description": "A lightweight VS Code extension outline for managing Docker Compose projects and containers.",
  "version": "0.0.1",
  "publisher": "local-dev",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:docklite.configureRuntime",
    "onCommand:docklite.openRuntimeSettings",
    "onCommand:docklite.refreshContainers",
    "onCommand:docklite.openContainerDetails",
    "onCommand:docklite.confirmDeleteContainer",
    "onCommand:docklite.openImageDetails",
    "onCommand:docklite.runImage",
    "onCommand:docklite.stopImageContainers",
    "onCommand:docklite.confirmDeleteImage",
    "onCommand:docklite.openVolumeDetails",
    "onCommand:docklite.confirmDeleteVolume",
    "onCommand:docklite.showLogs",
    "onCommand:docklite.startContainer",
    "onCommand:docklite.stopContainer",
    "onCommand:docklite.restartContainer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docklite.configureRuntime",
        "title": "Configure Runtime",
        "shortTitle": "Runtime",
        "icon": "$(settings-gear)"
      },
      {
        "command": "docklite.openRuntimeSettings",
        "title": "Docklite: Runtime Settings",
        "shortTitle": "Settings",
        "icon": "$(settings)"
      },
      {
        "command": "docklite.refreshContainers",
        "title": "Refresh Containers",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "docklite.showLogs",
        "title": "Show Container Logs",
        "shortTitle": "Logs",
        "icon": "$(output)"
      },
      {
        "command": "docklite.openContainerDetails",
        "title": "Open Container Details"
      },
      {
        "command": "docklite.confirmDeleteContainer",
        "title": "Delete Container",
        "shortTitle": "Delete",
        "icon": {
          "light": "resources/trash-red.svg",
          "dark": "resources/trash-red.svg"
        }
      },
      {
        "command": "docklite.openImageDetails",
        "title": "Open Image Details"
      },
      {
        "command": "docklite.runImage",
        "title": "Run Image",
        "shortTitle": "Run",
        "icon": {
          "light": "resources/play-green.svg",
          "dark": "resources/play-green.svg"
        }
      },
      {
        "command": "docklite.stopImageContainers",
        "title": "Stop Image Containers",
        "shortTitle": "Stop",
        "icon": {
          "light": "resources/stop-red.svg",
          "dark": "resources/stop-red.svg"
        }
      },
      {
        "command": "docklite.confirmDeleteImage",
        "title": "Delete Image",
        "shortTitle": "Delete",
        "icon": {
          "light": "resources/trash-red.svg",
          "dark": "resources/trash-red.svg"
        }
      },
      {
        "command": "docklite.openVolumeDetails",
        "title": "Open Volume Details"
      },
      {
        "command": "docklite.confirmDeleteVolume",
        "title": "Delete Volume",
        "shortTitle": "Delete",
        "icon": {
          "light": "resources/trash-red.svg",
          "dark": "resources/trash-red.svg"
        }
      },
      {
        "command": "docklite.startContainer",
        "title": "Start Container",
        "shortTitle": "Start",
        "icon": {
          "light": "resources/play-green.svg",
          "dark": "resources/play-green.svg"
        }
      },
      {
        "command": "docklite.stopContainer",
        "title": "Stop Container",
        "shortTitle": "Stop",
        "icon": {
          "light": "resources/stop-red.svg",
          "dark": "resources/stop-red.svg"
        }
      },
      {
        "command": "docklite.restartContainer",
        "title": "Docklite: Restart Container"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "docklite",
          "title": "Docklite",
          "icon": "resources/docker-lite.svg"
        }
      ]
    },
    "views": {
      "docklite": [
        {
          "id": "docklite.containers",
          "name": "Containers"
        }
      ]
    },
    "configuration": {
      "title": "Docklite",
      "properties": {
        "docklite.runtime.colimaCpu": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 32,
          "description": "CPU count used when Docklite creates a Colima runtime."
        },
        "docklite.runtime.colimaMemoryGiB": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 128,
          "description": "Memory in GiB used when Docklite creates a Colima runtime."
        },
        "docklite.runtime.colimaDiskGiB": {
          "type": "number",
          "default": 60,
          "minimum": 8,
          "maximum": 2048,
          "description": "Disk size in GiB used when Docklite creates a Colima runtime."
        },
        "docklite.runtime.colimaVmType": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "vz",
            "qemu"
          ],
          "description": "VM backend used when Docklite creates a Colima runtime. Auto uses vz on macOS and qemu on Linux."
        },
        "docklite.runtime.colimaSetupTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 60,
          "maximum": 3600,
          "description": "Maximum seconds Docklite waits for Colima setup."
        },
        "docklite.runtime.dockerDesktopTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 30,
          "maximum": 3600,
          "description": "Maximum seconds Docklite waits for Docker Desktop to become reachable."
        },
        "docklite.runtime.dockerEngineTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 15,
          "maximum": 600,
          "description": "Maximum seconds Docklite waits for Linux Docker Engine to become reachable."
        },
        "docklite.runtime.wslDockerTimeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 30,
          "maximum": 1200,
          "description": "Maximum seconds Docklite waits for Docker inside WSL2 to become reachable."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "docklite.refreshContainers",
          "when": "view == docklite.containers",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "docklite.configureRuntime",
          "when": "view == docklite.containers && viewItem == daemonStopped",
          "group": "inline@1"
        },
        {
          "command": "docklite.refreshContainers",
          "when": "view == docklite.containers && viewItem == containerRoot",
          "group": "inline@1"
        },
        {
          "command": "docklite.startContainer",
          "when": "view == docklite.containers && viewItem == stoppedContainer",
          "group": "inline@1"
        },
        {
          "command": "docklite.stopContainer",
          "when": "view == docklite.containers && viewItem == runningContainer",
          "group": "inline@1"
        },
        {
          "command": "docklite.showLogs",
          "when": "view == docklite.containers && (viewItem == runningContainer || viewItem == stoppedContainer)",
          "group": "inline@3"
        },
        {
          "command": "docklite.confirmDeleteContainer",
          "when": "view == docklite.containers && (viewItem == runningContainer || viewItem == stoppedContainer)",
          "group": "inline@4"
        },
        {
          "command": "docklite.runImage",
          "when": "view == docklite.containers && viewItem == stoppedImage",
          "group": "inline@1"
        },
        {
          "command": "docklite.stopImageContainers",
          "when": "view == docklite.containers && viewItem == runningImage",
          "group": "inline@1"
        },
        {
          "command": "docklite.confirmDeleteImage",
          "when": "view == docklite.containers && (viewItem == runningImage || viewItem == stoppedImage)",
          "group": "inline@2"
        },
        {
          "command": "docklite.confirmDeleteVolume",
          "when": "view == docklite.containers && viewItem == volume",
          "group": "inline@1"
        },
        {
          "command": "docklite.restartContainer",
          "when": "view == docklite.containers && (viewItem == runningContainer || viewItem == stoppedContainer)",
          "group": "actions"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
